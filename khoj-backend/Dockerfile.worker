FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
WORKDIR /srv/khoj
COPY pyproject.toml requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock && playwright install --with-deps chromium
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY app ./app
COPY config ./config
RUN useradd --create-home khoj && chmod -R a+rX /opt/playwright
USER khoj
CMD ["arq", "app.jobs.worker.WorkerSettings"]
