!artifacts/b2-followup/baseline/models.yaml
!artifacts/b2-followup/baseline/cases.v1.jsonl
!artifacts/b2-followup/baseline/frozen-hashes.json
artifacts/**/out.mp3
out.mp3

# MSW's runtime worker is recreated by npm install, not committed as generated code.
/frontend/public/mockServiceWorker.js

# Voice source material, speaker identities, recordings and supporting documents.
voices/**
!voices/**/
!voices/**/README*
!voices/**/*manifest*template*
!voices/**/*manifest*example*
!voices/**/scripts/**
voices/_originals/
voices/_private/
voices/**/speaker_key*.csv
voices/**/*.wav
voices/**/*.mp3
voices/**/*.m4a
voices/**/*.flac
voices/**/*.ogg
voices/**/*.webm
voices/**/*.mp4
voices/**/*.pdf
voices/**/*.jpg
voices/**/*.png

# Private connector directories always win over documentation exceptions above.
artifacts/zipnet-inspection/

# Unused original exports and legacy artwork; retain optimized runtime assets and licenses.
/frontend/public/characters/*.png
/frontend/public/sample-people/*.png
/frontend/public/fonts/**/*.ttf
/frontend/public/illustrations/
/frontend/public/hilos-character.svg
next-env.d.ts

# Local publication audit reports are generated, not source.
/artifacts/publication/

# Generated audio exports and speech evaluation data.
*.zip
output/
khoj_speech_eval_v1/
artifacts/**/*.wav
artifacts/**/*.mp3
artifacts/**/*.m4a
artifacts/**/*.webm

# Local synthetic STT diagnostic.
/artifacts/speech-eval/hinglish_script_check.md

# Local field recovery diagnostic.
/artifacts/speech-eval/field_diagnostic.md

# Local speech evaluation preregistrations.
/artifacts/speech-eval/*_preregistration.md

# Held-out evaluation sets: quarantined until isolation is verified and reviewer sign-off is recorded.
/khoj-backend/evals/heldout_v3/
/khoj-backend/evals/heldout_v4/

# Local dry-run markers, in any folder.
**/.dryrun_ok

# Held-out evaluation sets: quarantined until isolation is verified and reviewer sign-off is recorded.
/khoj-backend/evals/heldout_v3/
/khoj-backend/evals/heldout_v4/

# Local dry-run markers, in any folder.
**/.dryrun_ok

# Held-out sets v3 and v4: file-level rules, so they apply even when a folder is absent.
/khoj-backend/evals/heldout_v3/**
/khoj-backend/evals/heldout_v4/**
