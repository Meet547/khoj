KHOJ_ENV=development
DEMO_AUTH=1
DATABASE_URL=postgresql+asyncpg://khoj:khoj@localhost:5432/khoj
REDIS_URL=redis://localhost:6379/0
# Run make env to generate private random development keys.
JWT_SECRET=
PHONE_HMAC_SECRET=
# URL-safe base64 of 32 random bytes.
PHONE_ENC_KEY=
ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000
ENABLE_PGVECTOR=0
GNANI_API_KEY=
OLLAMA_API_KEY=
GNANI_STT_SLOTS=1
GNANI_TTS_SLOTS=2
KHOJ_TTS_VOICE=Shivani
TTS_MODEL=timbre-v3.0
TTS_SPEED=1.0
TTS_URL_TTL=900
# Set 1 during deployment to prepare static speech before accepting requests.
KHOJ_PREGEN_TTS=0
KHOJ_TTS_LANGS=en,hi
# Optional dev-only local cache path; production/staging require R2.
# TTS_CACHE_DIR=.cache/tts
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=khoj-private
KHOJ_CONTACT=
