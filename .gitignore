# Credentials: templates are source-controlled; actual environments are private.
.env
.env.*
!.env.example
!**/.env.example

# Dependencies, builds, databases and local execution state.
node_modules/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.next/
out/
coverage/
playwright-report/
test-results/
dist/
*.db
*.sqlite
*.bak
*.log
*.tsbuildinfo
.DS_Store
*.egg-info/
.coverage
htmlcov/
.cache/

# Private connector captures and development uploads.
fixtures/
khoj-backend/fixtures/
artifacts/zipnet-inspection.zip
artifacts/zipnet-inspection/

# Generated evidence stays local. Publish documentation and curated regression inputs.
artifacts/**
!artifacts/**/
# Aggregate speech-evaluation reports only (explicit allowlist).
!artifacts/speech-eval/wer_report.md
!artifacts/speech-eval/field_recovery.md
!artifacts/speech-eval/field_recovery_run2.md
!artifacts/speech-eval/normalisation_rescore.md
